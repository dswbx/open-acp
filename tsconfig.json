{
   "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "strict": true,
      "skipLibCheck": true,
      "declaration": true,
      "outDir": "dist",
      "rootDir": "src",
      "types": [
         "node",
         "bun",
         "vitest/globals"
      ],
      "allowImportingTsExtensions": true,
      "rewriteRelativeImportExtensions": true,
      "verbatimModuleSyntax": true,
      "baseUrl": ".",
      "paths": {
         "@/*": [
            "./src/*"
         ]
      }
   },
   "include": [
      "src/**/*.ts"
   ]
}
