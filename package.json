{
  "name": "agent-orchestrator-poc",
  "version": "1.0.0",
  "description": "ACP-based agent orchestrator core",
  "type": "module",
  "main": "dist/bun/index.js",
  "scripts": {
    "app:start": "vite build && electrobun dev",
    "app:dev": "electrobun dev --watch",
    "app:dev:hmr": "concurrently \"vite --port 5173\" \"electrobun dev --watch\"",
    "build": "npm run build:core && npm run build:ui",
    "build:core": "tsc -p tsconfig.json",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "smoke:real-agent": "tsx ./src/cli/real-agent-smoke-cli.ts",
    "smoke:claude": "npm run smoke:real-agent -- --cmd npx --args \"-y @agentclientprotocol/claude-agent-acp\" --cwd . --prompt \"Reply with one short sentence.\"",
    "smoke:codex": "npm run smoke:real-agent -- --cmd npx --args \"-y @zed-industries/codex-acp\" --cwd . --prompt \"Reply with one short sentence.\"",
    "smoke:opencode": "npm run smoke:real-agent -- --cmd opencode --args \"acp\" --cwd . --prompt \"Reply with one short sentence.\"",
    "typecheck": "npm run typecheck:core && npm run typecheck:ui",
    "typecheck:core": "tsc -p tsconfig.json --noEmit",
    "typecheck:ui": "tsc -p tsconfig.ui.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.19.0",
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@rive-app/react-webgl2": "^4.28.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@xyflow/react": "^12.10.2",
    "ai": "^6.0.168",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electrobun": "^1.16.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.8.0",
    "media-chrome": "^4.19.0",
    "motion": "^12.38.0",
    "nanoid": "^5.1.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-jsx-parser": "^2.4.1",
    "shadcn": "^4.3.0",
    "shiki": "^4.0.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.3.8",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
