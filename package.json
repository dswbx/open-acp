{
  "name": "open-acp",
  "version": "2026.4.3-beta.3",
  "description": "ACP-based agent orchestrator core",
  "type": "module",
  "main": "dist/bun/index.js",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "prepare": "lefthook install || true",
    "dev": "concurrently \"vite --port 5173\" \"electrobun dev --watch\"",
    "dev:desktop": "electrobun dev --watch",
    "dev:web": "vite",
    "start": "vite build && electrobun dev",
    "build": "bun run build:core && bun run build:ui",
    "build:canary": "bun run build:ui && electrobun build --env=canary",
    "build:core": "tsc -p tsconfig.core.json",
    "build:stable": "bun run build:ui && electrobun build --env=stable",
    "build:ui": "vite build",
    "typecheck": "bun run typecheck:core && bun run typecheck:ui",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "typecheck:ui": "tsc -p tsconfig.ui.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=./test-results/junit.xml",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "smoke:real-agent": "bun ./src/cli/real-agent-smoke-cli.ts",
    "smoke:claude": "bun run smoke:real-agent -- --cmd bunx --args \"-y @agentclientprotocol/claude-agent-acp\" --cwd . --prompt \"Reply with one short sentence.\"",
    "smoke:codex": "bun run smoke:real-agent -- --cmd codex --args \"app-server\" --transportKind codex-native --cwd . --prompt \"Reply with one short sentence.\"",
    "smoke:qwen": "bun run smoke:real-agent -- --cmd bunx --args \"-y @qwen-code/qwen-code --acp\" --cwd . --prompt \"Reply with one short sentence.\"",
    "smoke:opencode": "bun run smoke:real-agent -- --cmd opencode --args \"acp\" --cwd . --prompt \"Reply with one short sentence.\"",
    "fixture:export": "bun ./scripts/export-e2e-fixture.ts",
    "release:apply-version": "bun ./scripts/release/apply-version.ts",
    "release:compute-version": "bun ./scripts/release/compute-version.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.19.0",
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@rive-app/react-webgl2": "^4.28.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-mention": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@tiptap/suggestion": "^3.22.4",
    "@xyflow/react": "^12.10.2",
    "ai": "^6.0.168",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electrobun": "^1.16.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.8.0",
    "media-chrome": "^4.19.0",
    "motion": "^12.38.0",
    "nanoid": "^5.1.9",
    "react": "^19.2.5",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.2.5",
    "react-jsx-parser": "^2.4.1",
    "react-resizable-panels": "^2.1.9",
    "shadcn": "^4.3.0",
    "shiki": "^4.0.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tippy.js": "^6.3.7",
    "tiptap-markdown": "^0.9.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.3.8",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.14.0",
    "lefthook": "^2.1.6",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
